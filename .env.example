# Salin file ini ke .env lalu isi nilainya

PORT=3000

# Domain publik server ini (dipakai untuk redirect, link email, dan generate QR code).
# Wajib https:// di produksi.
BASE_URL=http://localhost:3000

# API key dari Google Cloud Console, aktifkan "Places API"
# https://console.cloud.google.com/apis/library/places-backend.googleapis.com
# Batasi key ini di Google Cloud Console (HTTP referrer / IP restriction).
GOOGLE_PLACES_API_KEY=

# Kunci rahasia untuk mengakses endpoint admin (GET /api/admin/cards).
# Isi dengan string acak yang panjang, jangan dibagikan.
ADMIN_API_KEY=

# --- Email pengiriman link reset PIN ---
# Kalau dikosongkan, link reset akan dicetak ke console server (mode pengembangan).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ulasin <no-reply@ulasin.id>"

# Set "true" kalau server ini menerima trafik HTTP langsung (bukan lewat reverse proxy
# yang sudah menangani HTTPS) dan ingin memaksa redirect ke HTTPS.
FORCE_HTTPS=false
